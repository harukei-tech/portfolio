APP_NAME="Portfolio API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# この API は DB を使わない（キャッシュは本番では DynamoDB）
DB_CONNECTION=sqlite
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Astro 側のオリジン（カンマ区切りで複数可）
CORS_ALLOWED_ORIGINS=http://localhost:4321

# お問い合わせの通知先。ローカルではメールはログ (storage/logs/laravel.log) に出力される
CONTACT_TO_ADDRESS=you@example.com
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# GitHub API（任意）。トークンなしだと 60 req/h の制限
GITHUB_TOKEN=
# 統計取得を許可する GitHub オーナー（カンマ区切り、空なら制限なし）
GITHUB_ALLOWED_OWNERS=
GITHUB_CACHE_TTL=3600

AWS_DEFAULT_REGION=ap-northeast-1
