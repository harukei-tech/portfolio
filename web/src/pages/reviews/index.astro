---
import Base from '../../layouts/Base.astro';
import EntryCard from '../../components/EntryCard.astro';
import { getGroupEntries, groups } from '../../lib/sections';

const group = groups.reviews;
const entries = await getGroupEntries('reviews');
---

<Base title={group.title} description={group.intro}>
  <section class="section container">
    <h1>{group.title}</h1>
    <p class="muted">{group.intro}</p>
    <div class="grid">{entries.map((entry) => <EntryCard entry={entry} />)}</div>
  </section>
</Base>
