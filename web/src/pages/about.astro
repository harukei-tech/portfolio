---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';

const links = Object.entries(profile.links).filter(([, href]) => href);
---

<Base title="About">
  <section class="section container about">
    <h1>About</h1>
    <p class="name">{profile.name} <span class="muted">/ {profile.role}</span></p>
    {profile.bio.map((p) => <p>{p}</p>)}

    <h2>Skills</h2>
    <dl class="skills">
      {
        profile.skills.map((s) => (
          <div>
            <dt>{s.category}</dt>
            <dd>
              <ul class="tags">{s.items.map((i) => <li class="tag">{i}</li>)}</ul>
            </dd>
          </div>
        ))
      }
    </dl>

    <h2>このサイトについて</h2>
    <p>
      Astro で静的生成し、GitHub Pages で公開しています。
    </p>

    {
      links.length > 0 && (
        <>
          <h2>Links</h2>
          <ul>
            {links.map(([label, href]) => (
              <li>
                <a href={href} target="_blank" rel="noopener">{label}</a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>
</Base>

<style>
  .about {
    max-width: 800px;
  }

  .name {
    font-size: 1.2rem;
    font-weight: 700;
  }

  h2 {
    margin-top: 2.4em;
    font-size: 1.2rem;
  }

  .skills {
    display: grid;
    gap: 12px;
  }

  .skills > div {
    display: grid;
    grid-template-columns: 7em 1fr;
    gap: 12px;
    align-items: center;
  }

  dt {
    color: var(--muted);
    font-size: 0.9rem;
  }

  dd {
    margin: 0;
  }
</style>
