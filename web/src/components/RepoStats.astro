---
/**
 * Laravel API から GitHub リポジトリの統計（スター数など）を取得して表示する。
 * 同じページ内の RepoStats はまとめて 1 回のリクエストで取得する。
 * API が未設定・失敗した場合はリポジトリへのリンクだけを表示する。
 *
 * 【API 停止中】統計の取得はコメントアウトしており、現在はリポジトリへのリンクのみ表示する。
 * 再開するときは、このファイル内の「API 停止中」のコメントを外す（lib/utils.ts の apiUrl も）。
 */
// API 停止中
// import { apiUrl } from '../lib/utils';

interface Props {
  repo: string;
  compact?: boolean;
}

const { repo, compact = false } = Astro.props;
---

{/* API 停止中: 再開時は data-api={apiUrl} を戻す */}
<div class:list={['repo-stats', { compact }]} data-repo={repo}>
  <a href={`https://github.com/${repo}`} target="_blank" rel="noopener" class="repo-link">
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"
      ><path
        fill="currentColor"
        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
      ></path></svg
    >
    {repo}
  </a>
  {/* API 停止中
  <span class="stats" aria-live="polite"></span>
  */}
</div>

<style>
  .repo-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    font-size: 0.85rem;
  }

  .repo-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    text-decoration: none;
    font-family: var(--mono);
    overflow-wrap: anywhere;
  }

  .repo-link:hover {
    color: var(--accent);
  }

  .stats {
    color: var(--muted);
  }

  .compact .repo-link {
    display: none;
  }
</style>

<script>
  // API 停止中: 統計の取得処理をコメントアウト
  /*
