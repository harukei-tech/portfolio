---
/**
 * 一覧カード用のサムネイル。
 * 画像（frontmatter の thumbnail、または images/ にある .md と同名の画像）があれば最適化して表示し、
 * なければプラットフォーム名や OSS 名から色分けした代わりの画像を表示する。
 */
import { Image } from 'astro:assets';
import { sections, type AnyEntry } from '../lib/sections';
import { resolveThumbnail } from '../lib/thumbnail';

interface Props {
  entry: AnyEntry;
}

const { entry } = Astro.props;
const { data } = entry;

// 代わりの画像の配色（背景・文字）。どれも文字とのコントラスト比 4.5:1 以上
const PALETTES = [
  { bg: '#e3ebe4', fg: '#2f5a45' }, // セージ
  { bg: '#dfe6ee', fg: '#344f6e' }, // くすんだ青
  { bg: '#efe2d9', fg: '#7a4024' }, // テラコッタ
  { bg: '#e9e0ea', fg: '#5c3f60' }, // くすんだ紫
  { bg: '#efe8d4', fg: '#644e17' }, // マスタード
  { bg: '#e0eaea', fg: '#2c5858' }, // 青緑
];

// よく使うプラットフォームは色を固定して、見分けやすくする
const FIXED: Record<string, number> = { slack: 3, mattermost: 1, discord: 5, line: 0 };

function paletteFor(key: string) {
  const fixed = FIXED[key.toLowerCase()];
  if (fixed !== undefined) return PALETTES[fixed];
  const hash = [...key].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
  return PALETTES[hash % PALETTES.length];
}

const label =
  entry.collection === 'bots'
    ? entry.data.platform
    : entry.collection === 'reviews'
      ? entry.data.oss
      : entry.collection === 'poc'
        ? entry.data.title
        : (entry.data.platform ?? entry.data.title);
const kind = sections[entry.collection].kind;
const chips = (entry.collection === 'reviews' ? entry.data.tags : entry.data.tech).slice(0, 3);
const palette = paletteFor(label);
const alt = data.thumbnailAlt ?? data.title;
const image = resolveThumbnail(entry);
---

<div class="thumb">
  {
    image ? (
      <Image
        src={image}
        alt={alt}
        widths={[400, 800]}
        sizes="(max-width: 640px) 100vw, 400px"
        loading="lazy"
      />
    ) : (
      <div class="placeholder" style={`--ph-bg: ${palette.bg}; --ph-fg: ${palette.fg};`} role="img" aria-label={alt}>
        <span class="kind">{kind}</span>
        <span class="label">{label}</span>
        {chips.length > 0 && <span class="chips">{chips.join(' · ')}</span>}
      </div>
    )
  }
</div>

<style>
  .thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: var(--code-bg);
  }

  .thumb :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    height: 100%;
    padding: 0 24px;
    background: var(--ph-bg);
    color: var(--ph-fg);
  }

  .kind {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .label {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .chips {
    font-size: 0.8rem;
  }
</style>
